#
# To clean up the repo, run `git clean -Xdf`
# NOTE: This is destructive and will wipe anything besides the source tree!
#

# Ignore everything in the root directory, whitelist stuff later
/*/
/*

# Ignore Kate editor temp files
*.kate-swp

# Ignore local patches
*.patch
*.rej
*.orig

# Ignore clang-analyzer output
*.plist

# Explicitly track source directories
!/include
!/src
!/tools
/tools/*
!/tools/guest_control.py
!/tools/boot_bench.py
!/tools/README.md
!/tools/build-pgo.ps1
!/tools/benchmark-pgo.ps1
!/tools/libernt-workload.py

# Explicitly track build system
!/Makefile
!/project.mk
!/CMakeLists.txt
!/Doxyfile

# Explicitly track CI infrastructure
!/.github
!/.gitlab-ci.yml

# Explicitly track repository metadata
!/README*
!/LICENSE*
!/.mailmap
!/.gitignore
!/.clang-format

!/tests
/tests/*
!/tests/fpu-rounding.c
!/tests/pmu.c
!/tests/pmu-sbi.c
!/tests/pmu-sbi.S
!/tests/pmu-sbi.ld
!/tests/libernt-pmu.c
!/tests/README-pmu.md
!/tests/run-pmu-sbi.py
!/tests/tlb-bench.c
!/tests/run-tlb-bench.py
!/tests/README-tlb.md
